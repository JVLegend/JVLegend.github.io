---

<script>
  // Delegated listeners survive Astro navigation without accumulating handlers.
  const media = window.matchMedia("(prefers-color-scheme: dark)");
  const desktop = window.matchMedia("(min-width: 1280px)");
  let chosenTheme: string | null = null;
  try {
    chosenTheme = localStorage.getItem("theme");
  } catch {
    /* Storage may be unavailable. */
  }

  function applyTheme() {
    const defaultTheme = document.documentElement.dataset.awTheme || "system";
    const selected = defaultTheme.endsWith(":only")
      ? defaultTheme.replace(":only", "")
      : chosenTheme || defaultTheme;
    const dark =
      selected === "dark" || (selected === "system" && media.matches);
    document.documentElement.classList.toggle("dark", dark);
    document
      .querySelectorAll("[data-aw-toggle-color-scheme]")
      .forEach((button) => {
        button.setAttribute("aria-pressed", String(dark));
      });
  }

  function setMenu(open: boolean, restoreFocus = false) {
    const header = document.getElementById("header");
    const button = header?.querySelector<HTMLButtonElement>(
      "[data-aw-toggle-menu]",
    );
    if (!header || !button) return;
    button.classList.toggle("expanded", open);
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute(
      "aria-label",
      document.documentElement.lang.startsWith("en")
        ? open
          ? "Close menu"
          : "Open menu"
        : open
          ? "Fechar menu"
          : "Abrir menu",
    );
    document.body.classList.toggle("overflow-hidden", open);
    for (const name of ["h-screen", "expanded", "bg-page"])
      header.classList.toggle(name, open);
    header.querySelector("nav")?.classList.toggle("hidden", !open);
    header
      .querySelector("[data-aw-header-actions]")
      ?.classList.toggle("hidden", !open);
    document
      .querySelectorAll<HTMLElement>("main, footer")
      .forEach((element) => {
        element.inert = open;
      });
    if (open) header.querySelector<HTMLAnchorElement>("nav a")?.focus();
    else if (restoreFocus) button.focus();
  }

  function updateHeader() {
    document
      .querySelector("#header[data-aw-sticky-header]")
      ?.classList.toggle("scroll", window.scrollY > 60);
  }

  function initializePage() {
    applyTheme();
    setMenu(false);
    updateHeader();
    document.documentElement.classList.add("motion-safe:scroll-smooth");
  }

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const menuButton = event.target.closest("[data-aw-toggle-menu]");
    if (menuButton) {
      setMenu(menuButton.getAttribute("aria-expanded") !== "true");
      return;
    }
    if (event.target.closest("[data-aw-toggle-color-scheme]")) {
      if (document.documentElement.dataset.awTheme?.endsWith(":only")) return;
      chosenTheme = document.documentElement.classList.contains("dark")
        ? "light"
        : "dark";
      try {
        localStorage.setItem("theme", chosenTheme);
      } catch {
        /* Keep this session's preference. */
      }
      applyTheme();
      return;
    }
    if (event.target.closest("#header a")) setMenu(false);

    const share = event.target.closest("[data-aw-social-share]");
    if (!share) return;
    const url = encodeURIComponent(share.getAttribute("data-aw-url") || "");
    const text = encodeURIComponent(share.getAttribute("data-aw-text") || "");
    const targets: Record<string, string> = {
      facebook: `https://www.facebook.com/sharer.php?u=${url}`,
      twitter: `https://twitter.com/intent/tweet?url=${url}&text=${text}`,
      linkedin: `https://www.linkedin.com/shareArticle?mini=true&url=${url}&title=${text}`,
      whatsapp: `https://wa.me/?text=${text}%20${url}`,
      mail: `mailto:?subject=${text}&body=${text}%20${url}`,
    };
    const href = targets[share.getAttribute("data-aw-social-share") || ""];
    if (!href) return;
    const link = document.createElement("a");
    link.href = href;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.click();
  });

  document.addEventListener("keydown", (event) => {
    const header = document.querySelector<HTMLElement>("#header.expanded");
    if (!header) return;
    if (event.key === "Escape") {
      event.preventDefault();
      setMenu(false, true);
    } else if (event.key === "Tab") {
      const focusable = Array.from(
        header.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
      ).filter((element) => element.getClientRects().length > 0);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });

  let framePending = false;
  document.addEventListener(
    "scroll",
    () => {
      if (framePending) return;
      framePending = true;
      window.requestAnimationFrame(() => {
        updateHeader();
        framePending = false;
      });
    },
    { passive: true },
  );
  desktop.addEventListener("change", () => setMenu(false));
  media.addEventListener("change", applyTheme);
  window.addEventListener("pageshow", initializePage);
  document.addEventListener("astro:page-load", initializePage);
  initializePage();
</script>
