---
// #JoaoVictor #SEO #Tecnologia
import { getPageSeo } from "~/utils/seo";
const page = getPageSeo(Astro.url.pathname);
---

{
  page && (
    <nav
      class="portfolio-container portfolio-breadcrumbs"
      aria-label="Breadcrumb"
    >
      <ol>
        {page.crumbs.map((crumb, index) => (
          <li>
            {index > 0 && <span aria-hidden="true">/</span>}
            {index === page.crumbs.length - 1 ? (
              <span aria-current="page">{crumb.name}</span>
            ) : (
              <a href={crumb.path}>{crumb.name}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
<style>
  .portfolio-breadcrumbs {
    padding-top: 24px;
    font-size: 13px;
    color: var(--portfolio-muted);
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  [aria-current="page"] {
    color: var(--portfolio-white);
  }
</style>
