---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getPageLocale } from '~/utils/i18n';
// #Tecnologia #JoaoVictor
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

const { isEnglish: isEnPage, home, ptPath: ptUrl, enPath: enUrl } = getPageLocale(currentPath);
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      'relative text-default py-3 px-3 xl:px-6 mx-auto w-full',
      {
        'xl:flex xl:justify-between': position !== 'center',
      },
      {
        'xl:grid xl:grid-cols-[auto_1fr_auto] xl:items-center': position === 'center',
      },
      {
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
      <a class="flex items-center" href={home}>
        <Logo />
      </a>
      <div class="flex items-center xl:hidden">
        <ToggleMenu label={isEnPage ? "Open menu" : "Abrir menu"} controls={`${id}-navigation`} />
      </div>
    </div>
    <nav
      id={`${id}-navigation`}
      class="items-center w-full xl:w-auto hidden xl:flex xl:mx-5 text-default overflow-y-auto overflow-x-hidden xl:overflow-y-visible xl:overflow-x-auto xl:justify-self-center"
      aria-label={isEnPage ? "Main navigation" : "Navegação principal"}
    >
      <ul
        class="flex flex-col xl:flex-row xl:self-center w-full xl:w-auto text-xl xl:text-[0.9375rem] tracking-[0.01rem] font-medium xl:justify-center"
      >
        {
          links.map(({ text, href, links }) => (
            <li class={links?.length ? 'dropdown' : ''}>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap"
                  >
                    {text}{' '}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden xl:inline" />
                  </button>
                  <ul class="dropdown-menu xl:backdrop-blur-md dark:xl:bg-dark rounded xl:absolute pl-4 xl:pl-0 xl:hidden font-medium xl:bg-white/90 xl:min-w-[200px] drop-shadow-xl">
                    {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            'first:rounded-t last:rounded-b xl:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-no-wrap',
                            { 'aw-link-active': href2 === currentPath },
                          ]}
                          href={href2}
                          aria-current={href2 === currentPath ? "page" : undefined}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                    { 'aw-link-active': href === currentPath },
                  ]}
                  href={href}
                  aria-current={href === currentPath ? "page" : undefined}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div
      data-aw-header-actions
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'hidden xl:self-center xl:flex items-center xl:mb-0 fixed w-full xl:w-auto xl:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 xl:p-0 xl:justify-self-end',
      ]}
    >
      <div class="items-center flex justify-between w-full xl:w-auto">
        <div class="flex items-center">
          <a
            href={ptUrl}
            lang="pt-BR" hreflang="pt-BR"
            aria-label="Português (Brasil)"
            title="Português"
            class:list={['p-2.5 min-h-11 min-w-11 justify-center inline-flex items-center rounded-lg', isEnPage ? 'opacity-40 hover:opacity-100' : '']}
          >
            <svg class="w-6 h-4 rounded-[2px] shadow-sm" viewBox="0 0 20 14" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="20" height="14" fill="#009c3b" />
              <path d="M10 1.5 L18.5 7 L10 12.5 L1.5 7 Z" fill="#ffdf00" />
              <circle cx="10" cy="7" r="2.6" fill="#002776" />
            </svg>
          </a>
          <a
            href={enUrl}
            lang="en" hreflang="en"
            aria-label="English (US)"
            title="English"
            class:list={['p-2.5 min-h-11 min-w-11 justify-center inline-flex items-center rounded-lg', !isEnPage ? 'opacity-40 hover:opacity-100' : '']}
          >
            <svg class="w-6 h-4 rounded-[2px] shadow-sm" viewBox="0 0 20 14" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="20" height="14" fill="#b22234" />
              <rect y="2" width="20" height="2" fill="#ffffff" />
              <rect y="6" width="20" height="2" fill="#ffffff" />
              <rect y="10" width="20" height="2" fill="#ffffff" />
              <rect width="9" height="7" fill="#3c3b6e" />
            </svg>
          </a>
          {showToggleTheme && <ToggleTheme label={isEnPage ? "Toggle dark mode" : "Alternar modo escuro"} iconClass="w-6 h-6 xl:w-5 xl:h-5 xl:inline-block" />}
          {
            showRssFeed && (
              <a
                class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label="RSS Feed"
                href={getAsset('/rss.xml')}
              >
                <Icon name="tabler:rss" class="w-5 h-5" />
              </a>
            )
          }
        </div>
        {
          actions?.length ? (
            <span class="ml-4 rtl:ml-0 rtl:mr-4">
              {actions.map((btnProps) => (
                <Button {...btnProps} class="ml-2 py-2.5 px-5.5 xl:px-6 font-semibold shadow-none text-sm w-auto" />
              ))}
            </span>
          ) : (
            ''
          )
        }
      </div>
    </div>
  </div>
</header>
