---
// #Tecnologia #JoaoVictor
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Palestras e workshops',
  description: 'Palestras e workshops de João Victor Dias sobre IA aplicada, pesquisa, saúde e liderança técnica.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero2
    tagline="Palestras"
    title="Palestras e Keynotes"
    subtitle="Compartilhando conhecimento sobre IA, liderança e inovação"
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Flexibilidade e Personalização</h3>
      Todas as apresentações podem ser customizadas para o público-alvo específico,
      incluindo adaptação de conteúdo, duração e nível técnico conforme necessário.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-900/30 via-indigo-900/30 to-purple-900/30"></div>
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="speaking-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="30" r="8" stroke="white" stroke-width="2" fill="none" opacity="0.5"/>
            <line x1="50" y1="38" x2="50" y2="55" stroke="white" stroke-width="2" opacity="0.5"/>
            <line x1="50" y1="55" x2="35" y2="75" stroke="white" stroke-width="2" opacity="0.5"/>
            <line x1="50" y1="55" x2="65" y2="75" stroke="white" stroke-width="2" opacity="0.5"/>
            <line x1="50" y1="45" x2="35" y2="50" stroke="white" stroke-width="2" opacity="0.5"/>
            <line x1="50" y1="45" x2="65" y2="50" stroke="white" stroke-width="2" opacity="0.5"/>
            <path d="M30,20 Q50,10 70,20" stroke="white" stroke-width="1.5" fill="none" opacity="0.4"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#speaking-pattern)"/>
      </svg>
    </Fragment>
  </Hero2>

  <!-- Audience Section -->

  <Features
    id="audience"
    tagline="Público-Alvo"
    title="Para Quem São as Palestras"
    subtitle="Conteúdo adaptado para diferentes perfis profissionais"
    noAnimation={true}
    items={[
      {
        title: 'C-Level e Executivos',
        description:
          'Visão estratégica sobre IA, ROI e impacto nos negócios.',
        icon: 'tabler:crown',
      },
      {
        title: 'CTOs e Diretores de TI',
        description:
          'Implementação técnica, arquitetura e gestão de projetos de IA.',
        icon: 'tabler:settings',
      },
      {
        title: 'Gestores de Produto',
        description:
          'Como integrar IA em produtos e serviços, UX com IA.',
        icon: 'tabler:package',
      },
      {
        title: 'Profissionais de Dados',
        description:
          'Técnicas avançadas, melhores práticas e evolução na carreira.',
        icon: 'tabler:database',
      },
      {
        title: 'Empreendedores',
        description:
          'Oportunidades de negócio, validação de ideias e funding.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Profissionais de Saúde',
        description:
          'Aplicações específicas de IA na medicina e impacto no atendimento.',
        icon: 'tabler:stethoscope',
      },
    ]}
  />

  <Features
    tagline="CBO 2026"
    title="Materiais de IA para oftalmologia"
    subtitle="Aulas interativas para explorar conceitos, ferramentas e aplicações no consultório."
    items={[
      { title: 'Conceitos e agentes de IA', description: '<a class="underline text-blue-600 dark:text-blue-400" href="https://cbo-2026-conceitos-agentes.vercel.app/" target="_blank" rel="noopener noreferrer">Acessar a aula interativa</a>', icon: 'tabler:brain' },
      { title: 'ChatGPT, Claude e Gemini', description: '<a class="underline text-blue-600 dark:text-blue-400" href="https://cbo-2026-plataformas.vercel.app/" target="_blank" rel="noopener noreferrer">Explorar plataformas e aplicações</a>', icon: 'tabler:device-laptop' },
      { title: 'Como aplicar IA no meu consultório?', description: '<a class="underline text-blue-600 dark:text-blue-400" href="https://cbo-2026-drylab-consultorio.vercel.app/" target="_blank" rel="noopener noreferrer">Abrir os exercícios do DryLab</a>', icon: 'tabler:tools' },
    ]}
  />

  <Content tagline="Trajetória" title="Seleção de aulas e workshops">
    <Fragment slot="content">
      <ul class="space-y-4 text-gray-600 dark:text-gray-300">
        <li><strong>CBO, 2025:</strong> coordenação de WetLab sobre desenvolvimento de modelos de inteligência artificial.</li>
        <li><strong>IBGE, 2024:</strong> introdução a LLMs e RAG na 7ª Semana de Iniciação Científica.</li>
        <li><strong>FMUSP, 2024:</strong> inteligência artificial na pesquisa científica e telemedicina aplicada à oftalmologia.</li>
        <li><strong>Bradesco Innovation Day, 2020:</strong> inteligência artificial, privacidade e Open Banking.</li>
      </ul>
      <p class="mt-6"><a href="/cv" class="underline text-blue-600 dark:text-blue-400">Ver a trajetória completa no currículo</a></p>
    </Fragment>
  </Content>

  <!-- Testimonials would go here if we had them -->

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Solicitar Proposta',
        href: '/contact',
        icon: 'tabler:mail',
      },
      {
        variant: 'secondary',
        text: 'Ver Portfolio',
        href: '/cv',
        icon: 'tabler:file-text',
      },
    ]}
  >
    <Fragment slot="title">
      Quer levar conteúdo de <br class="block sm:hidden" /><span class="sm:whitespace-nowrap">qualidade para seu evento?</span>
    </Fragment>

    <Fragment slot="subtitle">
      Entre em contato para discutir sua necessidade específica, customizar o conteúdo
      <br class="hidden md:inline" />e agendar uma apresentação memorável.
    </Fragment>
  </CallToAction>
</Layout>
