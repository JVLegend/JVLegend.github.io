---
// #Tecnologia #JoaoVictor
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import techBack from '~/assets/images/tech_back.jpg';
import pic07 from '~/assets/images/pic07.jpg';
import digitalMedTwin from '~/assets/images/digitalmedtwin.png';

const metadata = {
  title: 'Projects and business',
  description: 'João Victor Dias’s work in artificial intelligence, digital health, research and education.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero2
    tagline="Ecosystem"
    title="AI applied to healthcare, research and education"
    subtitle="Technology projects developed with healthcare professionals, researchers and business teams."
    image={{ src: techBack, alt: 'IA Médica e Tecnologia' }}
  />

  <!-- Content Widget **************** -->

  <Content
    tagline="Model"
    title="How the ecosystem works"
  >
    <Fragment slot="content">
      <p>My work combines AI engineering, data and product development. I collaborate with different teams to turn practical needs into software, automations and research tools. The projects below span different stages of development and use.</p>
      <br />
      <p class="mobile-table-hint">Swipe sideways to see all columns ↔</p>
              <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Scrollable table; use arrow keys to see all columns"><table class="w-full text-left text-base">
        <caption class="sr-only">Projects and areas of work</caption>
        <thead><tr><th scope="col" class="p-3">Project</th><th scope="col" class="p-3">Focus</th></tr></thead>
        <tbody>
          <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="p-3 font-semibold">IA para Médicos</th><td class="p-3">AI apps, digital presence and education</td></tr>
          <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="p-3 font-semibold">WingsAI</th><td class="p-3">Applied research and AI development</td></tr>
          <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="p-3 font-semibold">GeekVision</th><td class="p-3">Digital products and ophthalmology</td></tr>
          <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="p-3 font-semibold">ConnectAI / Repport AI</th><td class="p-3">Medical sales intelligence and reports</td></tr>
          <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="p-3 font-semibold">Lyen</th><td class="p-3">Medical jobs platform</td></tr>
          <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="p-3 font-semibold">Spero Science</th><td class="p-3">Applied AI</td></tr>
        </tbody>
      </table></div>
      <br />
      <p>Since 2026, João Victor is also <strong>partner and CTO at Lyen</strong> (medical jobs platform) and <strong>CTO at Spero Science AI</strong>.</p>
    </Fragment>
  </Content>

<section id="arb" class="scroll-mt-24 py-16 md:py-20"><div class="max-w-7xl mx-auto px-4 sm:px-6"><h2 class="text-3xl md:text-4xl font-bold font-heading mb-6 dark:text-white">ARB · Education, Software and Laboratory</h2><div class="text-lg text-gray-600 dark:text-gray-300 max-w-4xl"><p>I founded ARB and work on Data and AI. Led by CEO Karine Dias, the technology company brings together training and masterminds, custom software and the ARB Stok, ARB Fin, ARB Equip and ARB CRM product lines, plus a laboratory for papers, competitions and innovation. Raul Primo is a Software Engineer on the team.</p><p class="mt-4"><a class="text-blue-600 dark:text-blue-400 hover:underline" href="https://arb-studio.vercel.app/" target="_blank" rel="noopener noreferrer">ARB ↗</a></p></div></div></section>

  <!-- Wings AI Section -->

  <Content
    tagline="Company 1"
    title="WingsAI"
    image={{
      src: techBack,
      alt: 'Wings AI',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Deeptech · Applied R&amp;D</h3>
      <p class="mb-4">Integrated portfolio of AI solutions spanning multiple sectors, from micro-SaaS to specialized health education.</p>
    </Fragment>
  </Content>

  <Features
    id="apps-publicados"
    tagline="Products"
    title="Apps in the portfolio"
    subtitle="Selected apps for healthcare, productivity and digital experiences."
    items={[
      {
        title: 'AutoRefratorGeek',
        description:
          'Refraction support for the ophthalmology practice. Part of the GeekVision B2B suite.',
        icon: 'tabler:eye',
      },
      {
        title: 'ClinicaDocs',
        description:
          'Fast clinical documentation for medical practices. Part of the GeekVision B2B suite.',
        icon: 'tabler:files',
      },
      {
        title: 'Visão Subnormal',
        description:
          'Support tool for low-vision patients.',
        icon: 'tabler:accessible',
      },
      {
        title: 'RepportAI and RepportAI Plus',
        description:
          'AI reports and sales intelligence for healthcare (ConnectAI / Repport AI).',
        icon: 'tabler:report-medical',
      },
      {
        title: 'Revela',
        description:
          'Event photos shared via QR code (B2C and B2B).',
        icon: 'tabler:camera',
      },
      {
        title: 'Consumer line',
        description:
          'David: The Anointed, Heroes of Faith, SuaAventura and Troféus do Mundo.',
        icon: 'tabler:apps',
      },
    ]}
  />

  <Features
    id="sites-plataformas"
    tagline="Web"
    title="Sites &amp; Platforms"
    items={[
      {
        title: 'WingsAI',
        description:
          '<a href="https://www.wingsgroup.ai/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">wingsgroup.ai</a> · AI deeptech applied to health.',
        icon: 'tabler:world',
      },
      {
        title: 'IA para Médicos',
        description:
          '<a href="https://iaparamedicos.com.br/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">iaparamedicos.com.br</a> · courses and AI assistants for medical scientific writing.',
        icon: 'tabler:school',
      },
      {
        title: 'Protocolo Medicina',
        description:
          '<a href="https://protocolomedicina.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">protocolomedicina.vercel.app</a> · AI medical image quality analysis.',
        icon: 'tabler:photo',
      },
      {
        title: 'BlinkTracking',
        description:
          '<a href="https://blinktracking.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">blinktracking.vercel.app</a> · blink analysis for research (FMUSP PhD).',
        icon: 'tabler:eye-check',
      },
    ]}
  />

  <Features
    id="wingsai-aihouse"
    tagline="Vertical 2: AI House"
    title="Custom AI Solutions"
    subtitle="Tailor-made AI systems for companies"
    items={[
      {
        title: 'AI Consulting',
        description:
          'Strategic advisory for implementing AI solutions.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Custom Development',
        description:
          'Custom AI models for specific business needs.',
        icon: 'tabler:code',
      },
      {
        title: 'Systems Integration',
        description:
          'Integrating AI into existing technology infrastructure.',
        icon: 'tabler:plug',
      },
      {
        title: 'Intelligent Automation',
        description:
          'Automated processes with machine learning and AI.',
        icon: 'tabler:robot',
      },
    ]}
  />

  <Content
    isReversed
    tagline="Vertical 3: HealthTech"
    title="AI Applied to Medicine"
    items={[
      {
        title: 'National Medical Imaging Protocol',
        description: 'National framework for standardizing and optimizing medical image quality, developed with rigorous scientific methodology.',
      },
      {
        title: 'Diagnostic Quality Framework',
        description: 'AI algorithms for automatic quality assessment of ophthalmic images, developed for research and technical evaluation.',
      },
      {
        title: 'Intelligent Clinical Automation',
        description: 'AI-powered clinical decision support systems to optimize diagnostics and clinical outcomes.',
      },
      {
        title: 'Telemedicine with AI',
        description: 'Remote care platform integrated with AI tools for triage and analysis.',
      },
    ]}
    image={{
      src: digitalMedTwin,
      alt: 'HealthTech AI',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Digital Transformation of Medical Practice</h3>
      AI solutions for healthcare focused on diagnostic quality and evidence-based medicine. Work in applied research and software development for healthcare professionals.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Features
    id="wingsai-educacional"
    tagline="Vertical 4: Education"
    title="AI Education for Healthcare Professionals"
    subtitle="Specialized training in AI applied to medicine"
    items={[
      {
        title: 'Specialized Courses',
        description:
          'Medical AI training programs for healthcare professionals, from beginner to advanced.',
        icon: 'tabler:school',
      },
      {
        title: 'Individual Mentoring',
        description:
          'Personalized guidance for physicians implementing AI in their clinical practice.',
        icon: 'tabler:user-check',
      },
      {
        title: 'Hands-on Workshops',
        description:
          'Hands-on training on AI tools applied to diagnostics and practice management.',
        icon: 'tabler:tools',
      },
      {
        title: 'Medical Digital Transformation',
        description:
          'Training on digitalization strategies for practices and clinics with AI.',
        icon: 'tabler:device-laptop',
      },
    ]}
  />

  <!-- Instituto Rumo ao Topo Section -->

  <Features
    id="instituto"
    tagline="Pillar 2"
    title="Instituto Rumo ao Topo"
    subtitle="Building communities focused on faith and technology"
    items={[
      {
        title: 'Online Communities',
        description:
          'Digital platforms connecting Christian technology professionals.',
        icon: 'tabler:world',
      },
      {
        title: 'In-person Events',
        description:
          'Conferences and meetups on faith, ethics and technology innovation.',
        icon: 'tabler:calendar-event',
      },
      {
        title: 'Spiritual Mentoring',
        description:
          'Mentoring program for Christian leaders in technology.',
        icon: 'tabler:user-heart',
      },
      {
        title: 'Educational Content',
        description:
          'Content on integrating Christian faith and technology leadership.',
        icon: 'tabler:book',
      },
    ]}
  />

  <!-- Palestras Section -->

  <Content
    tagline="Pillar 3"
    title="Talks &amp; Keynotes"
    items={[
      {
        title: 'Medical AI: The Ally, Not the Replacement',
        description: 'How AI augments medical diagnosis without replacing the professional.',
      },
      {
        title: 'Medical Image Quality Framework',
        description: 'HC-FMUSP methodology for diagnostic optimization in ophthalmology.',
      },
      {
        title: 'Bridging Medicine and Technology',
        description: 'Strategies for integrating AI into clinical practice with evidence-based medicine.',
      },
      {
        title: 'Christian Leadership in Tech',
        description: 'Servant leadership and purpose in building health technology.',
      },
    ]}
    image={{
      src: pic07,
      alt: 'Talks',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Medical AI Expertise</h3>
      Speaker specialized in AI applications in medicine. More than a decade of experience + HC-FMUSP + Christian technology leadership. Topics bridging medicine and technology.
    </Fragment>
  </Content>

  <!-- R12 EdTech Section -->

  <Features
    id="r12"
    tagline="Pillar 4"
    title="R12: Tech Education with Social Impact"
    subtitle="Training young tech talent for the digital future"
    items={[
      {
        title: 'Programming Education',
        description:
          'Full software development (Python) and service desk courses for young talent.',
        icon: 'tabler:code',
      },
      {
        title: 'AI Training',
        description:
          'Training in AI, machine learning and agile methodologies.',
        icon: 'tabler:robot',
      },
      {
        title: 'Digital Inclusion',
        description:
          'Technology inclusion programs in regions with limited tech education.',
        icon: 'tabler:accessible',
      },
      {
        title: 'Soft Skills Development',
        description:
          'Focus on behavioral skills, communication and neuroscience applied to learning.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Job Market Readiness',
        description:
          'Employability and placement of young people in the tech market.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Social Impact &amp; ESG',
        description:
          'Aligned with UN SDGs 4, 8 and 10 for sustainable development and social responsibility.',
        icon: 'tabler:world',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Partnership Contact',
        href: '/en/contact',
        icon: 'tabler:users',
      },
      {
        variant: 'secondary',
        text: 'See Talks',
        href: '/speaking',
        icon: 'tabler:microphone',
      },
    ]}
  >
    <Fragment slot="title">
      Interested in<br class="block sm:hidden" /><span class="sm:whitespace-nowrap"> Collaborating?</span>
    </Fragment>

    <Fragment slot="subtitle">
      Get in touch to discuss partnership and investment opportunities,
      <br class="hidden md:inline" />or collaboration on AI and innovation projects.
    </Fragment>
  </CallToAction>
</Layout>
