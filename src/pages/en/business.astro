---
// #Tecnologia #JoaoVictor
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import techBack from '~/assets/images/tech_back.jpg';

const metadata = {
  title: 'Projects and business',
  description: 'João Victor Dias’s work in artificial intelligence, digital health, research and education.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero2
    tagline="Ecosystem"
    title="AI applied to healthcare, research and education"
    subtitle="Technology projects developed with healthcare professionals, researchers and business teams."
    image={{ src: techBack, alt: 'IA Médica e Tecnologia' }}
  />

  <!-- Content Widget **************** -->

  <Content
    tagline="Model"
    title="How the ecosystem works"
  >
    <Fragment slot="content">
      <p>My work combines AI engineering, data and product development. I collaborate with different teams to turn practical needs into software, automations and research tools. The projects below span different stages of development and use.</p>
      <br />
      <p class="mobile-table-hint">Swipe sideways to see all columns ↔</p>
              <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Scrollable table; use arrow keys to see all columns"><table class="w-full text-left text-base">
        <caption class="sr-only">Projects and areas of work</caption>
        <thead><tr><th scope="col" class="p-3">Project</th><th scope="col" class="p-3">Focus</th></tr></thead>
        <tbody>
          <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="p-3 font-semibold">IA para Médicos</th><td class="p-3">AI apps, digital presence and education</td></tr>
          <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="p-3 font-semibold">WingsAI</th><td class="p-3">Applied research and AI development</td></tr>
          <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="p-3 font-semibold">GeekVision</th><td class="p-3">Digital products and ophthalmology</td></tr>
          <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="p-3 font-semibold">ConnectAI / Repport AI</th><td class="p-3">Medical sales intelligence and reports</td></tr>
          <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="p-3 font-semibold">Lyen</th><td class="p-3">Medical jobs platform</td></tr>
          <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="p-3 font-semibold">Spero Science</th><td class="p-3">Applied AI</td></tr>
        </tbody>
      </table></div>
      <br />
      <p>Since 2026, João Victor is also <strong>partner and CTO at Lyen</strong> (medical jobs platform) and <strong>CTO at Spero Science AI</strong>.</p>
    </Fragment>
  </Content>

<section id="arb" class="scroll-mt-24 py-16 md:py-20"><div class="max-w-7xl mx-auto px-4 sm:px-6"><h2 class="text-3xl md:text-4xl font-bold font-heading mb-6 dark:text-white">ARB · Education, Software and Laboratory</h2><div class="text-lg text-gray-600 dark:text-gray-300 max-w-4xl"><p>I co-founded ARB, where I serve as CTO. Led by CEO Karine Dias, the technology company brings together training and masterminds, custom software and the ARB Stok, ARB Fin, ARB Equip and ARB CRM product lines, plus a laboratory for papers, competitions and innovation. Raul Primo is a Software Engineer on the team.</p><p class="mt-4"><a class="text-blue-600 dark:text-blue-400 hover:underline" href="https://arb-studio.vercel.app/" target="_blank" rel="noopener noreferrer">ARB ↗</a></p></div></div></section>

  <!-- Wings AI Section -->

  <Content
    tagline="Company"
    title="WingsAI"
    image={{
      src: techBack,
      alt: 'Wings AI',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Deeptech · Applied R&amp;D</h3>
      <p class="mb-4">Integrated portfolio of AI solutions spanning multiple sectors, from micro-SaaS to specialized health education.</p>
    </Fragment>
  </Content>

  <Features
    id="apps-publicados"
    tagline="Products"
    title="Apps in the portfolio"
    subtitle="Selected apps for healthcare, productivity and digital experiences."
    items={[
      {
        title: 'AutoRefratorGeek',
        description:
          'Refraction support for the ophthalmology practice. Part of the GeekVision B2B suite.',
        icon: 'tabler:eye',
      },
      {
        title: 'ClinicaDocs',
        description:
          'Fast clinical documentation for medical practices. Part of the GeekVision B2B suite.',
        icon: 'tabler:files',
      },
      {
        title: 'Visão Subnormal',
        description:
          'Support tool for low-vision patients.',
        icon: 'tabler:accessible',
      },
      {
        title: 'RepportAI and RepportAI Plus',
        description:
          'AI reports and sales intelligence for healthcare (ConnectAI / Repport AI).',
        icon: 'tabler:report-medical',
      },
      {
        title: 'Revela',
        description:
          'Event photos shared via QR code (B2C and B2B).',
        icon: 'tabler:camera',
      },
      {
        title: 'Consumer line',
        description:
          'David: The Anointed, Heroes of Faith, SuaAventura and Troféus do Mundo.',
        icon: 'tabler:apps',
      },
    ]}
  />

  <Features
    id="sites-plataformas"
    tagline="Web"
    title="Sites &amp; Platforms"
    items={[
      {
        title: 'WingsAI',
        description:
          '<a href="https://www.wingsgroup.ai/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">wingsgroup.ai</a> · AI deeptech applied to health.',
        icon: 'tabler:world',
      },
      {
        title: 'IA para Médicos',
        description:
          '<a href="https://iaparamedicos.com.br/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">iaparamedicos.com.br</a> · courses and AI assistants for medical scientific writing.',
        icon: 'tabler:school',
      },
      {
        title: 'Protocolo Medicina',
        description:
          '<a href="https://protocolomedicina.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">protocolomedicina.vercel.app</a> · AI medical image quality analysis.',
        icon: 'tabler:photo',
      },
      {
        title: 'BlinkTracking',
        description:
          '<a href="https://blinktracking.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">blinktracking.vercel.app</a> · blink analysis for research (FMUSP PhD).',
        icon: 'tabler:eye-check',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Partnership Contact',
        href: '/en/contact',
        icon: 'tabler:users',
      },
      {
        variant: 'secondary',
        text: 'See Talks',
        href: '/speaking',
        icon: 'tabler:microphone',
      },
    ]}
  >
    <Fragment slot="title">
      Interested in<br class="block sm:hidden" /><span class="sm:whitespace-nowrap"> Collaborating?</span>
    </Fragment>

    <Fragment slot="subtitle">
      Get in touch to discuss partnership and investment opportunities,
      <br class="hidden md:inline" />or collaboration on AI and innovation projects.
    </Fragment>
  </CallToAction>
</Layout>
