---
// #Tecnologia #JoaoVictor
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `Página não encontrada`;
---

<Layout metadata={{ title, robots: { index: false, follow: true } }}>
  <section class="flex items-center min-h-[60vh] px-4 py-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h1 class="mb-8 font-bold text-8xl sm:text-9xl">
          <span class="sr-only">Erro</span>
          <span class="text-primary">404</span>
        </h1>
        <p class="text-3xl font-semibold md:text-3xl">Não encontramos esta página.</p>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          O endereço pode ter mudado. Acesse a página inicial para encontrar o conteúdo que procura.
        </p>
        <a rel="noopener noreferrer" href={getHomePermalink()} class="btn ml-4">Voltar ao início</a>
      </div>
    </div>
  </section>
</Layout>
